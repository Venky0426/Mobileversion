    // Events rules - Public discovery allowed
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Communities rules - Public discovery allowed, authenticated creation & ownership edit/delete
    match /communities/{communityId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // Connections rules - Authenticated users can send, accept, decline connection requests
    match /connections/{connectionId} {
      allow read, write: if request.auth != null;
    }

    // User Private Device Tokens - Only the authenticated owner can read/write their tokens
    match /users/{userId}/tokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User Private Notification Preferences - Only the authenticated owner can read/write
