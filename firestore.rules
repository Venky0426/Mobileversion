rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles rules
    match /profiles/{profileId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Messages rules
